rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção de Oficinas:
    match /workshops/{workshopId} {
      // Qualquer visitante ou motorista pode visualizar oficinas no mapa
      allow read: if true;

      // Apenas usuários autenticados podem cadastrar oficinas vinculando ao seu próprio UID
      allow create: if request.auth != null 
                    && request.resource.data.ownerId == request.auth.uid;

      // Apenas o proprietário registrado pode atualizar ou excluir a oficina
      allow update, delete: if request.auth != null 
                            && resource.data.ownerId == request.auth.uid;
    }

    // Coleção de Perfis de Usuário:
    match /users/{userId} {
      // Qualquer usuário autenticado pode ler dados de perfil
      allow read: if request.auth != null;

      // Cada usuário só pode criar ou atualizar seu próprio perfil
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // Exclusão protegida
      allow delete: if false;
    }

    // Coleção de Cotações / Orçamentos WhatsApp:
    match /quotes/{quoteId} {
      // Leitura e gravação permitidas para usuários autenticados
      allow read, write: if request.auth != null;
    }
  }
}
